# お問い合わせフォームの送信先。
# JSON を POST で受けられるエンドポイントなら何でもよい
# （Slack Incoming Webhook / Zapier / Make / 自前の API など）。
#
# 未設定のときフォームは「成功」を返さず、メールでの連絡を案内する。
# 送信内容を黙って捨てないための仕様。本番では必ず設定すること。
CONTACT_WEBHOOK_URL=

# CONTACT_WEBHOOK_URL に NEXT_PUBLIC_ は付けないこと。
# クライアントバンドルに埋め込まれて公開される。


# 本番の正規URL。canonical / OGPの絶対URL / sitemap / JSON-LD の基準になる。
# 未設定だと content/site.ts の既定値（仮ドメイン）が使われる。
# Vercel では Production に本番ドメイン、Preview には設定しない
# （設定するとプレビューが本番URLをcanonicalに指してしまう）。
NEXT_PUBLIC_SITE_URL=https://shindo.zen-bu.co
