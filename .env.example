# お問い合わせフォームの送信に使う Resend の API キー。
#
# Vercel Marketplace の Resend 連携が自動で設定するため、
# 手で入れる必要はない。ローカルで動かすときは:
#     vercel env pull
# で .env.local に降ってくる。
#
# 未設定のときフォームは「成功」を返さず、メールでの連絡を案内する。
# 送信内容を黙って捨てないための仕様。
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=zen-bu.co


# 本番の正規URL。canonical / OGPの絶対URL / sitemap / JSON-LD の基準になる。
# 未設定だと content/site.ts の既定値が使われる。
# Vercel では Production に本番ドメイン、Preview には設定しない
# （設定するとプレビューが本番URLをcanonicalに指してしまう）。
NEXT_PUBLIC_SITE_URL=https://shindo-omega.vercel.app
